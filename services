"""
Feedback and Autoregulation Module for the AI Personal Trainer.
Processes performance reports, RPE (Rating of Perceived Exertion), and fatigue
to determine automatic adjustments in periodization (progression, maintenance, or deload).
"""
from typing import Dict, Any


class TrainingFeedbackEngine:
    def __init__(self):
        # Limiares de RPE e RIR para tomada de decisão
        self.rpe_high_threshold = 9.5
        self.rpe_low_threshold = 7.0

    def analyze_feedback(self, session_data: Dict[str, Any]) -> Dict[str, Any]:
        """
        Analisa o feedback pós-treino do aluno.
        
        session_data esperado:
        {
            "exercise": "Supino Reto",
            "target_rir": 2,
            "actual_rir": 0,
            "rpe": 10.0,
            "fatigue_level": "alto", # baixo, moderado, alto, extremo
            "completed_all_sets": True,
            "joint_discomfort": False
        }
        """
        rpe = session_data.get("rpe", 8.0)
        actual_rir = session_data.get("actual_rir", 2)
        target_rir = session_data.get("target_rir", 2)
        fatigue = session_data.get("fatigue_level", "moderado")
        discomfort = session_data.get("joint_discomfort", False)

        adjustment = {
            "action": "maintain",
            "load_modifier": 0.0,  # percentual de ajuste na carga (ex: +0.02 para +2%)
            "volume_modifier": 0,  # ajuste no número de séries
            "reason": ""
        }

        # Regra 1: Dor articular ou desconforto agudo -> Substituição imediata ou deload no exercício
        if discomfort:
            adjustment["action"] = "substitute_exercise"
            adjustment["reason"] = "Relato de desconforto articular. Necessária substituição por exercício com menor cisalhamento/estresse."
            return adjustment

        # Regra 2: Fadiga extrema ou RPE 10 consistente abaixo do RIR alvo -> Risco de overreaching excessivo
        if fatigue == "extremo" or (rpe >= 9.5 and actual_rir < target_rir - 1):
            adjustment["action"] = "deload_or_drop"
            adjustment["load_modifier"] = -0.05  # Reduz 5% da carga
            adjustment["volume_modifier"] = -1   # Remove 1 série de trabalho
            adjustment["reason"] = "Sinais de fadiga sistêmica acumulada ou queda de rendimento. Reduzindo volume e carga para recuperação."
            return adjustment

        # Regra 3: Progressão de carga (Progressive Overload) se RIR foi maior que o alvo (fácil)
        if actual_rir > target_rir + 1 and fatigue in ["baixo", "moderado"]:
            adjustment["action"] = "progress_load"
            adjustment["load_modifier"] = 0.03  # Aumenta 3% a 5% na próxima sessão
            adjustment["reason"] = "Desempenho acima do esperado com RIR folgado. Indicada progressão de carga."
            return adjustment

        # Padrão: Manter progressão atual
        adjustment["action"] = "maintain"
        adjustment["reason"] = "Progresso estável dentro da zona alvo de esforço (RIR/RPE)."
        return adjustment


